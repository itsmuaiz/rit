{
  "expo": {
    "name": "bolt-expo-nativewind",
    "slug": "bolt-expo-nativewind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      ["expo-location", { "locationAlwaysAndWhenInUsePermission": "Rit gebruikt je locatie om zakelijke kilometers nauwkeurig te meten, ook wanneer de app tijdelijk op de achtergrond staat." }]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
